# Copy to keystore.properties (never committed) and fill in for a real signed release.
# Generate the store once with the JDK's keytool:
#   keytool -genkeypair -v -keystore goldenballoon-release.jks -alias goldenballoon \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=goldenballoon-release.jks
storePassword=CHANGE_ME
keyAlias=goldenballoon
keyPassword=CHANGE_ME
