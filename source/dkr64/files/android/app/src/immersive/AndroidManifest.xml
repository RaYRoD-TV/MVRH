<?xml version="1.0" encoding="utf-8"?>
<!-- The immersive flavour: the same app, told to take over the headset. The one thing it adds is
     the VR intent category, which is what makes HorizonOS hand the app the display instead of a
     floating window, and also what makes it refuse to start while the controllers are off. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.rayrod.goldenballoon.GoldenBalloonActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
