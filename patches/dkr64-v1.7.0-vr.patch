+			continue;
+		break;
+	}
+	vr_set_view_mode(next);
+}
+
+extern "C" void vr_set_fp_switch_locked(bool locked)
+{
+	/* Locked means there is no gameplay feed this frame (menus, cutscenes, an
+	 * animated camera). Drop the seat heading with it, so the next engagement
+	 * ADOPTS the kart's heading instead of easing to it from a stale one: on a
+	 * mode edge the view cuts, it never glides. */
+	if (locked && !sFpSwitchLock)
+		sCockpitValid = false;
+	sFpSwitchLock = locked;
+}
+
+extern "C" void vr_set_cockpit_pose(const float posWorld[3], float yawRad, float pitchRad, float rollRad)
+{
+	sCockpitPos[0] = posWorld[0];
+	sCockpitPos[1] = posWorld[1];
+	sCockpitPos[2] = posWorld[2];
+	sCockpitPitch  = pitchRad;
+	sCockpitRoll   = rollRad;
+
+	/*
+	 * THE SEAT HEADING IS FILTERED, and this is not a preference.
+	 *
+	 * The fed yaw is the kart's raw combined visual rotation (steer visual plus
+	 * yaw velocity, racer.c). DKR never points a CAMERA at that: its chase cam
+	 * eases toward it over roughly half a second, and first person then
+	 * subtracts that eased camera yaw back out to get the heading delta -- which
+	 * cancels the game's own calming filter and leaves nothing in its place. The
+	 * whole view then swings at the kart's per-tick yaw RATE, which is what
+	 * driving in first person felt like.
+	 *
+	 * Shortest-path so a wrap at +/-pi cannot spin the world the long way round,
+	 * and in SECONDS so the feel does not change with the headset.
+	 */
+	if (!sCockpitValid)
+	{
+		sCockpitYaw = yawRad;             /* first feed: adopt, never ease in */
+	}
+	else if (fabsf(wrap_pi(yawRad - sCockpitYaw)) > 2.5f)
+	{
+		/* A near-half-turn jump in one frame is not a heading the kart can
+		 * produce (the fed yaw is the chase camera's own eased basis): it is
+		 * the look-behind flip arriving or leaving. On a view edge the law
+		 * is CUT, never glide - easing this through the filter swings the
+		 * whole world 180 degrees over the tail instead. */
+		sCockpitYaw = yawRad;
+	}
+	else
+	{
+		/* Was 0.12 s in the raw tick-rate feed era. The cockpit pose now
+		 * arrives INTERPOLATED per frame (mdkr_vr_first_person_poses_at),
+		 * which supplies its own within-tick smoothness; the old filter on
+		 * top of it was ~10 frames of pure lag at 120 Hz, felt as the view
+		 * trailing the kart -- "clunky". A short tail only, to absorb the
+		 * feed's residual quantisation. */
+		const float kSeatYawTau = 0.03f;  /* seconds to close ~63% of the gap */
+		const float dt = vr_frame_dt();
+		float k = dt / (kSeatYawTau + dt);
+		if (k < 0.0f) k = 0.0f;
+		if (k > 1.0f) k = 1.0f;
+		sCockpitYaw = wrap_pi(sCockpitYaw + wrap_pi(yawRad - sCockpitYaw) * k);
+	}
+	sCockpitValid  = true;
+}
+
+// Diagnostic readback of the filtered seat heading (radians), for the
+// MDKR_VR_TRACE_FP line.
+extern "C" float vr_get_cockpit_yaw(void)
+{
+	return sCockpitYaw;
+}
+
+extern "C" void vr_set_game_view(const float posWorld[3], float yawRad, float pitchRad, float rollRad, bool skyPass)
+{
+	if (!skyPass)
+	{
+		sGameViewPos[0] = posWorld[0];
+		sGameViewPos[1] = posWorld[1];
+		sGameViewPos[2] = posWorld[2];
+		sGameViewYaw    = yawRad;
+		// Consume the basis yaw fed just before this call; with none fed the
+		// basis IS the plain yaw, which is the pre-look-behind behaviour.
+		sGameViewBasisYaw = sGameViewBasisYawSet ? sGameViewBasisYawPending
+		                                         : yawRad;
+		sGameViewBasisYawSet = false;
+		sGameViewPitch  = pitchRad;
+		sGameViewRoll   = rollRad;
+		sGameViewValid  = true;
+	}
+	// Recompose with this pass's camera: the main feed lands between the
+	// skybox pass and the world pass of each eye, so both render against the
+	// view they were actually set up with.
+	vr_compose_mode_views(skyPass);
+}
