diff --git a/android/QUEST_PORT.md b/android/QUEST_PORT.md
new file mode 100644
index 0000000000000000000000000000000000000000..49a9c6c2935cedaf465292875dafa8a90c3458b6
--- /dev/null
+++ b/android/QUEST_PORT.md
@@ -0,0 +1,21 @@
+# Diddy Kong Racing VR on Quest
+
+This Android source is carried forward from the Golden Balloon 1.2.0 Quest
+port. The 1.7.0 source update has been built and checked on Windows. Its
+Android build and headset behavior have not yet been qualified.
+
+The game uses SDL2, GLES 3.2 and OpenXR on arm64-v8a. Native libraries are
+built with CMake and Android NDK 27, then staged into the Gradle project.
+The existing scripts use a short Windows junction at C:\g\dkrvr and an SDK
+at C:\Android\sdk. Set these paths for the local checkout before building.
+
+The immersive flavor is the standalone headset application. The panel
+flavor is a separate diagnostic application without the VR launch category.
+The application ID is com.rayrod.goldenballoon; the panel flavor adds .panel.
+
+The ROM belongs in the application's external files directory. Supported
+cartridge revisions are US 1.1 and European 1.1. No ROM or game assets are
+included. Release signing keys and local SDK settings must remain private.
+
+The existing Quest download remains available through the Multiverse VR Hub.
+This source patch does not publish a replacement APK.
diff --git a/android/app/build.gradle b/android/app/build.gradle
new file mode 100644
index 0000000000000000000000000000000000000000..9aa2f2f46dbdd4ea18890db2437a850ce474e175
--- /dev/null
+++ b/android/app/build.gradle
@@ -0,0 +1,85 @@
+apply plugin: 'com.android.application'
+
+// The native libraries (libmain.so, libSDL2.so, libopenxr_loader.so) are built OUTSIDE gradle
+// by the CMake/NDK build (build_native.ps1) and staged into src/main/jniLibs/arm64-v8a by
+// stage_native.ps1. Gradle only packages what it finds there.
+
+android {
+    namespace 'com.rayrod.goldenballoon'
+    compileSdkVersion 33
+
+    defaultConfig {
+        applicationId 'com.rayrod.goldenballoon'
+        minSdkVersion 26
+        targetSdkVersion 33
+        versionCode 1
+        versionName '0.1'
+        ndk {
+            abiFilters 'arm64-v8a'
+        }
+    }
+
+    // TWO SHELLS AROUND THE SAME BINARY.
+    //   immersive - the real thing: takes over the headset, and HorizonOS will not start it
+    //               while the Touch controllers are off.
+    //   panel     - the identical native code in the 2D shell. It installs alongside (.panel
+    //               suffix) and launches with the controllers off and the headset on a desk,
+    //               which is the only way to answer "does it boot and render at all" without
+    //               a headset on a face. Flat boot is checked here; the XR session and stereo
+    //               can only be judged in the immersive one.
+    flavorDimensions 'shell'
+    productFlavors {
+        immersive { dimension 'shell' }
+        panel {
+            dimension 'shell'
+            applicationIdSuffix '.panel'
+            versionNameSuffix '-panel'
+        }
+    }
+
+    // Release signing. Credentials live in keystore.properties beside the root build.gradle and
+    // are NEVER committed - see keystore.properties.example. If that file is absent the release
+    // build falls back to debug signing and says so out loud, so a public build cannot be shipped
+    // debug-signed by accident in silence. A keystore.properties still holding CHANGE_ME counts
+    // as NOT configured.
+    ext.releaseSigningReady = {
+        def f = rootProject.file('keystore.properties')
+        if (!f.exists()) { return false }
+        def p = new Properties(); f.withInputStream { p.load(it) }
+        def store = p['storePassword'], key = p['keyPassword']
+        return store && key && store != 'CHANGE_ME' && key != 'CHANGE_ME' &&
+               rootProject.file(p['storeFile'] ?: '').exists()
+    }
+    signingConfigs {
+        release {
+            if (releaseSigningReady()) {
+                def props = new Properties()
+                rootProject.file('keystore.properties').withInputStream { props.load(it) }
+                storeFile rootProject.file(props['storeFile'])
+                storePassword props['storePassword']
+                keyAlias props['keyAlias']
+                keyPassword props['keyPassword']
+            }
+        }
+    }
+    buildTypes {
+        release {
+            minifyEnabled false
+            if (releaseSigningReady()) {
+                signingConfig signingConfigs.release
+            } else {
+                logger.warn('keystore.properties missing or unconfigured - release will be DEBUG-SIGNED.')
+                logger.warn('Copy keystore.properties.example beside build.gradle and fill it in to sign for real.')
+                signingConfig signingConfigs.debug
+            }
+        }
+    }
+
+    // The loader and SDL are plain .so files staged in, not built here. Legacy packaging keeps
+    // them uncompressed and page-aligned, which is what the dynamic linker wants on device.
+    packagingOptions {
+        jniLibs {
+            useLegacyPackaging true
+        }
+    }
+}
diff --git a/android/app/src/immersive/AndroidManifest.xml b/android/app/src/immersive/AndroidManifest.xml
new file mode 100644
index 0000000000000000000000000000000000000000..f84ee0e4e36e911e81a34d5369d9d782f818c82b
--- /dev/null
+++ b/android/app/src/immersive/AndroidManifest.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The immersive flavour: the same app, told to take over the headset. The one thing it adds is
+     the VR intent category, which is what makes HorizonOS hand the app the display instead of a
+     floating window, and also what makes it refuse to start while the controllers are off. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <application>
+        <activity android:name="com.rayrod.goldenballoon.GoldenBalloonActivity">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+                <category android:name="com.oculus.intent.category.VR" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
diff --git a/android/app/src/main/AndroidManifest.xml b/android/app/src/main/AndroidManifest.xml
new file mode 100644
index 0000000000000000000000000000000000000000..16ea4208c97071cd4cac8bb83b9a502af8830617
--- /dev/null
+++ b/android/app/src/main/AndroidManifest.xml
@@ -0,0 +1,58 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Quest/VR entry set copied from the shipping SpaghettiKart and sm64coopdx Quest APKs rather
+     than written from memory: Khronos OpenXR permissions + the runtime-broker queries block
+     (mandatory on targetSdk 30+, package-visibility filtering otherwise hides the runtime), the
+     VR intent category, and optional headtracking so the APK still installs on a phone. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    android:installLocation="auto">
+
+    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
+    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
+    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
+    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" android:version="1" />
+
+    <!-- The ROM scan falls back to shared storage for a dump the player dropped somewhere else;
+         all-files access is requested through the system settings screen (see the activity). -->
+    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
+    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
+    <uses-permission android:name="android.permission.VIBRATE" />
+
+    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
+    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
+    <queries>
+        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
+        <intent>
+            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
+        </intent>
+        <intent>
+            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
+        </intent>
+    </queries>
+
+    <application
+        android:label="@string/app_name"
+        android:allowBackup="true"
+        android:hardwareAccelerated="true"
+        android:requestLegacyExternalStorage="true"
+        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
+
+        <activity
+            android:name="com.rayrod.goldenballoon.GoldenBalloonActivity"
+            android:exported="true"
+            android:launchMode="singleInstance"
+            android:alwaysRetainTaskState="true"
+            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
+            android:preferMinimalPostProcessing="true">
+            <!-- com.oculus.intent.category.VR is NOT here: it lives in the immersive
+                 flavour's manifest (src/immersive). HorizonOS refuses to start anything
+                 carrying that category while the Touch controllers are off, which makes
+                 an immersive build impossible to boot-test from a desk. The panel flavour
+                 leaves it out and runs in the 2D shell, which is exactly what answering
+                 "does the game come up and render at all" needs. -->
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
diff --git a/android/app/src/main/java/com/rayrod/goldenballoon/GoldenBalloonActivity.java b/android/app/src/main/java/com/rayrod/goldenballoon/GoldenBalloonActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..bf90829dd59ced20777ab62a5970aaf62d9ac0d2
--- /dev/null
+++ b/android/app/src/main/java/com/rayrod/goldenballoon/GoldenBalloonActivity.java
@@ -0,0 +1,88 @@
+package com.rayrod.goldenballoon;
+
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.provider.Settings;
+
+import java.io.File;
+
+import org.libsdl.app.SDLActivity;
+
+/**
+ * The game activity. Every piece of VR work happens in native code (OpenXR); this class guards
+ * the one Android prerequisite the engine cannot recover from mid-boot -- getting at the
+ * player's ROM. Ask for access, then STOP: booting the engine without a ROM would fail on its
+ * data before the player ever saw the permission toggle.
+ */
+public class GoldenBalloonActivity extends SDLActivity {
+
+    // The names a Diddy Kong Racing dump arrives under. The first is what the hub's Send to
+    // Quest writes; the rest are what a hand-dropped dump is usually called.
+    private static final String[] ROM_NAMES = {
+        "dkr.us.v80.z64",
+        "baserom.us.v80.z64",
+        "dkr.z64",
+        "Diddy Kong Racing (U) (V1.1).z64",
+    };
+
+    private boolean hasAllFilesAccess() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            return true;
+        }
+        return Environment.isExternalStorageManager();
+    }
+
+    private void requestAllFilesAccess() {
+        try {
+            Intent intent = new Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                    Uri.parse("package:" + getPackageName()));
+            startActivity(intent);
+        } catch (Exception e) {
+            // Some builds lack the per-app screen - fall back to the full list.
+            Intent intent = new Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION);
+            startActivity(intent);
+        }
+    }
+
+    // Send to Quest pushes the ROM straight into this app's own files dir, and the engine reads
+    // app-local files with no permission at all - the all-files scan is only the fallback for a
+    // dump the player dropped somewhere else. So when the ROM is already in place, boot. On the
+    // SM64 build the permission screen at first launch read as "the game will not start" to
+    // everyone who installed through the hub.
+    private boolean hasLocalRom() {
+        File dir = getExternalFilesDir(null);
+        if (dir == null) {
+            return false;
+        }
+        for (String name : ROM_NAMES) {
+            if (new File(dir, name).exists()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        if (!hasAllFilesAccess() && !hasLocalRom()) {
+            requestAllFilesAccess();
+            super.onCreate(savedInstanceState);
+            finish(); // ask, then stop - relaunch boots the game with access in hand
+            return;
+        }
+        super.onCreate(savedInstanceState);
+    }
+
+    // onResume deliberately does NOT re-ask: doing so opened the settings screen twice in a row
+    // on the SM64 build. One ask per launch.
+
+    // libopenxr_loader.so is a DT_NEEDED of libmain.so, so the linker pulls it out of the APK on
+    // its own; naming it here as well would load it twice.
+    @Override
+    protected String[] getLibraries() {
+        return new String[] { "SDL2", "main" };
+    }
+}
