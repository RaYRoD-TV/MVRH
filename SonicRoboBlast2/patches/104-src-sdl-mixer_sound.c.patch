+// VR underwater muffle: a one-pole low-pass (~900 Hz at 44.1k) over the final
+// mix while the view is submerged (g_vrWaterMuffle, set once per frame by the
+// VR loop). The wet amount ramps per-sample so engaging/surfacing never clicks.
+// Runs on the audio thread; reading the flag racily is harmless.
+#include "../vr/i_openxr.h" // g_vrWaterMuffle
+static void Muffle_PostMix(void *udata, Uint8 *stream, int len)
+{
+	static float wet = 0.0f, lpL = 0.0f, lpR = 0.0f;
+	INT16 *s = (INT16 *)stream;
+	int n = len / (int)sizeof(INT16);
+	const float target = g_vrWaterMuffle ? 1.0f : 0.0f;
+	int i;
+
+	(void)udata;
+	if (wet < 0.0005f && target == 0.0f)
+	{
+		lpL = lpR = 0.0f;
+		return; // fully dry: leave the mix untouched
+	}
+
+	for (i = 0; i + 1 < n; i += 2)
+	{
+		const float l = (float)s[i], r = (float)s[i+1];
+		wet += (target - wet) * 0.00035f; // ~60 ms ramp
+		lpL += (l - lpL) * 0.12f;
+		lpR += (r - lpR) * 0.12f;
+		s[i]   = (INT16)(l + (lpL - l) * wet);
+		s[i+1] = (INT16)(r + (lpR - r) * wet);
+	}
+}
+
