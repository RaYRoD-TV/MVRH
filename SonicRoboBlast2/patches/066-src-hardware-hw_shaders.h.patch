+//
+// SalCRT Sharp - a modern CRT for the final screen blit
+//
+// Ported from the Ring Racers VR build. Two differences, both because this
+// renderer has no way to hand a shader custom uniforms: the mask rides
+// gl_FragCoord, which IS screen pixels, so the pitch is exact at any window
+// size and no resolution uniform is needed; and the bloom's neighbour taps
+// step by dFdx/dFdy of the texture coordinate, which is the per-pixel UV step.
+//
+#define GLSL_CRTSHARP_FRAGMENT_SHADER \
+	"uniform sampler2D tex;\n" \
+	"uniform float crt_intensity;\n" \
+	"float crtLuma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }\n" \
+	"void main(void) {\n" \
+	"vec2 uv = gl_TexCoord[0].st;\n" \
+	"vec2 px = vec2(abs(dFdx(uv.x)), abs(dFdy(uv.y)));\n" \
+	"vec4 srcpx = texture2D(tex, uv);\n" \
+	"vec3 col = srcpx.rgb;\n" \
+	"vec3 nb = texture2D(tex, uv + vec2(px.x, 0.0)).rgb + texture2D(tex, uv - vec2(px.x, 0.0)).rgb + texture2D(tex, uv + vec2(0.0, px.y)).rgb + texture2D(tex, uv - vec2(0.0, px.y)).rgb;\n" \
+	"nb *= 0.25;\n" \
+	"vec3 bloom = max(nb - vec3(0.55), vec3(0.0)) * 0.50;\n" \
+	"float luma = crtLuma(col);\n" \
+	"col = mix(vec3(luma), col, 1.12);\n" \
+	"col = mix(col, col * col * (3.0 - 2.0 * col), 0.30);\n" \
+	"col += bloom;\n" \
+	"float s = 0.5 + 0.5 * sin(gl_FragCoord.y * 2.0943951);\n" \
+	"s = pow(s, 0.65);\n" \
+	"col *= mix(1.0, s, 0.38 * (1.0 - 0.5 * luma));\n" \
+	"float ph = fract(gl_FragCoord.x / 3.0) * 3.0;\n" \
+	"vec3 tri;\n" \
+	"float dr = abs(ph - 0.5);\n" \
+	"tri.r = 1.0 - smoothstep(0.5, 1.1, min(dr, 3.0 - dr));\n" \
+	"tri.g = 1.0 - smoothstep(0.5, 1.1, abs(ph - 1.5));\n" \
+	"tri.b = 1.0 - smoothstep(0.5, 1.1, abs(ph - 2.5));\n" \
+	"col *= mix(vec3(1.0), tri * 2.0, 0.22);\n" \
+	"vec2 vpos = uv - vec2(0.5);\n" \
+	"col *= 1.22 * (1.0 - 0.12 * dot(vpos, vpos) * 2.0);\n" \
+	"col = col - max(col - vec3(0.92), vec3(0.0)) * 0.6;\n" \
+	/* Whole-effect opacity: fade the finished CRT toward the clean frame. */ \
+	"col = mix(srcpx.rgb, col, crt_intensity);\n" \
+	"gl_FragColor = vec4(col, srcpx.a);\n" \
+	"}\0"
