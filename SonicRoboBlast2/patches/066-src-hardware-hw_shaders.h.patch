+// Megatron-style CRT: phosphor-mask simulation in the spirit of the Sony
+// Megatron Color Video Monitor shader family -- real mask geometry at
+// device-pixel scale, beam and mask math in LINEAR light -- rebuilt
+// single-pass for this GL2-era renderer rather than ported (the original is
+// a multi-pass HDR pipeline; a true mask eats up to two thirds of the light,
+// which HDR pays back with nits and SDR cannot, so the strength and
+// brightness sliders hand the player that trade instead). Mask type rides
+// gr_screeneffect: 1 = aperture grille (Trinitron vertical RGB stripes),
+// 2 = slot mask (stripes with staggered slots), 3 = shadow mask (diagonal
+// triads). Beam width follows brightness, the Megatron scanline model:
+// bright rows bloom fat, dark rows pinch thin. One texture fetch total, so
+// the per-eye cost in VR is negligible.
+#define GLSL_CRTMEGA_FRAGMENT_SHADER \
+	"uniform sampler2D tex;\n" \
+	"uniform float crt_mask;\n" \
+	"uniform float crt_strength;\n" \
+	"uniform float crt_boost;\n" \
+	"uniform float crt_intensity;\n" \
+	"void main(void) {\n" \
+	"vec4 src = texture2D(tex, gl_TexCoord[0].st);\n" \
+	"vec3 c = src.rgb * src.rgb;\n" \
+	"float luma = dot(c, vec3(0.299, 0.587, 0.114));\n" \
+	"float lribbon = min(luma * 1.5, 1.0);\n" \
+	"float d = fract(gl_FragCoord.y / 3.0) - 0.5;\n" \
+	"float w = mix(0.34, 0.62, lribbon);\n" \
+	"float scan = exp(-(d * d) / (w * w));\n" \
+	"float mx = mod(gl_FragCoord.x, 3.0);\n" \
+	"float band = floor(gl_FragCoord.y / 3.0);\n" \
+	"float k = mx;\n" \
+	"if (crt_mask > 2.5) { k = mod(mx + band, 3.0); }\n" \
+	"vec3 m = vec3(1.0 - step(1.0, k), step(1.0, k) - step(2.0, k), step(2.0, k));\n" \
+	"if (crt_mask > 1.5 && crt_mask < 2.5) {\n" \
+	"float stag = mod(floor(gl_FragCoord.x / 3.0), 2.0) * 3.0;\n" \
+	"float sph = fract((gl_FragCoord.y + stag) / 6.0);\n" \
+	"m *= mix(0.55, 1.0, smoothstep(0.0, 0.12, min(sph, 1.0 - sph)));\n" \
+	"}\n" \
+	/* Unit-energy phosphors: the lit phosphor carries its triad's three     */ \
+	/* pixels of light, so the mask RESTRUCTURES brightness instead of       */ \
+	/* taxing it -- the same trick the Ring Racers CRT's grille plays        */ \
+	/* (tri * 2.0 there), kept here in linear light. The image stays as     */ \
+	/* bright as the input at every strength; only highlights trade a       */ \
+	/* little headroom, and the soft knee below grades that instead of      */ \
+	/* clipping.                                                            */ \
+	"c *= mix(vec3(1.0), m * 3.0, crt_strength);\n" \
+	/* Brightness-adaptive scanline depth, as the Ring Racers CRT does it:  */ \
+	/* bright rows flatten, dark rows carve. The 1.12 pays back the         */ \
+	/* line-gap average so mid tones hold parity with the input.            */ \
+	"c *= mix(1.0, scan, 0.38 * (1.0 - 0.5 * lribbon));\n" \
+	"c *= 1.12 * crt_boost;\n" \
+	"c = clamp(c, 0.0, 1.0);\n" \
+	"vec3 g = sqrt(c);\n" \
+	"g = g - max(g - vec3(0.92), vec3(0.0)) * 0.5;\n" \
+	/* Whole-effect opacity: fade the finished CRT toward the clean frame. */ \
+	"g = mix(src.rgb, g, crt_intensity);\n" \
+	"gl_FragColor = vec4(g, src.a);\n" \
 	"}\0"
 
