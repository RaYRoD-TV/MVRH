+		"float caustic = pow(0.5 + 0.5 * cos((cwa + cwb) * 1.5707963), 4.0);\n" \
+		/* Soft knee: the gain eases toward a ceiling instead of climbing  */ \
+		/* linearly. vr_uwcaustic is ~0.8 at a full slider (the uniform is */ \
+		/* decoded /1000), so cgain peaks well inside the knee's graded    */ \
+		/* range -- this was never a binary strobe. The slight cool cast   */ \
+		/* reads as sun through water.                                     */ \
+		"float cgain = caustic * vr_uwcaustic * uwsun * cband;\n" \
+		"cgain = cgain / (1.0 + 0.8 * cgain);\n" \
+		"final_color.rgb *= vec3(1.0) + cgain * vec3(0.92, 1.0, 1.05);\n" \
+		"if (vr_uwfog <= 0.0) {\n" \
+			/* Eye above water: blue the depths seen through the surface -- */ \
+			/* the submerged world falls toward the water color with its    */ \
+			/* own depth, so a lake reads as a volume from the shore.       */ \
+			/* Depth tint removed: its per-surface inputs flip frame to frame  */ \
+			/* on walls near water, snapping whole surfaces between tinted   */ \
+			/* and clean - the colour-shift flashing. The caustic dapple     */ \
+			/* above is healthy and stays. Restore only with a stable,       */ \
+			/* verified per-sector water feed.                               */ \
+		"}\n" \
+	"}\n" \
+	"if (vr_uwfog > 0.0) {\n" \
+		"float fsub = clamp((vr_uwsurf - world_pos.y) * 0.0035, 0.0, 1.0);\n" \
+		"float uwd = gl_FragCoord.z / gl_FragCoord.w;\n" \
+		/* Submerged eye = ONE uniform medium: the fog depends on distance    */ \
+		/* alone, so it is continuous across every surface and sector by     */ \
+		/* construction. Two attempts at per-ray air handling (integrating   */ \
+		/* only the submerged span of rays that cross the surface) both      */ \
+		/* painted seams -- the air judgment lives per SURFACE, and adjacent */ \
+		/* sectors with different water tops met at a visible line no        */ \
+		/* gradient could hide. The world above a real surface reads a       */ \
+		/* touch hazier than physics says; nothing anywhere reads as an      */ \
+		/* edge. That trade is the right one.                                */ \
+		"vec3 uwatt = exp(-uwd * vr_uwfog * vec3(0.0072, 0.0028, 0.0018));\n" \
+		"vec3 uwamb = vr_uwcolor * mix(1.65, 0.4, fsub);\n" \
+		"final_color.rgb = mix(uwamb, final_color.rgb, uwatt);\n" \
+		/* God rays: march the eye->fragment ray through a world-anchored   */ \
+		/* shaft field -- the volume-side sibling of the caustics. Analytic */ \
+		/* (nothing boils) and world-space (both eyes agree, true parallax).*/ \
+		"if (vr_uwray > 0.0) {\n" \
+			"vec3 uwrd = world_pos - vr_eyepos;\n" \
+			"float shaft = 0.0;\n" \
+			/* Eight samples, not five: the sharpened field marched too       */ \
+			/* coarsely lets samples hop whole light columns as the view     */ \
+			/* drifts, and at full slider strength that reads as the water   */ \
+			/* flashing. Denser sampling crosses columns smoothly; the 0.625 */ \
+			/* renormalizes so the strength sliders keep their meaning.      */ \
+			"for (int uwi = 1; uwi <= 8; ++uwi) {\n" \
+				"vec3 sp = vr_eyepos + uwrd * (float(uwi) * 0.1111);\n" \
+				"float sd = clamp((vr_uwsurf - sp.y) * 0.0035, 0.0, 1.0);\n" \
+				"vec2 gp = sp.xz * 0.011;\n" \
+				"float g = sin(gp.x + leveltime * 0.55) * sin(gp.y * 0.83 - leveltime * 0.47);\n" \
+				"g = pow(clamp(0.5 + 0.7 * g, 0.0, 1.0), 4.0);\n" \
+				"shaft += g * (1.0 - sd) * step(0.0, vr_uwsurf - sp.y);\n" \
+			"}\n" \
+			"shaft *= 0.625;\n" \
+			/* Soft-saturate the shaft into a graded glow (vr_uwray is ~0.26  */ \
+			/* at a full slider -- the uniform is decoded /1000; K brings the */ \
+			/* march into the knee's responsive range). A smooth knee, not a  */ \
+			/* hard clamp, so the rays stay a gradient rather than an on/off  */ \
+			/* mask. Screen blend composes them over the caustics below.      */ \
+			"float rsun = 0.30 + 0.70 * clamp(lighting / 255.0, 0.0, 1.0);\n" \
+			"float rstr = shaft * vr_uwray * rsun * 5.0;\n" \
+			"rstr = rstr / (1.0 + rstr);\n" \
+			"vec3 uwray = vr_uwcolor * (rstr * 0.85);\n" \
+			"final_color.rgb = 1.0 - (1.0 - final_color.rgb) * (1.0 - uwray);\n" \
+		"}\n" \
+	"}\n"
