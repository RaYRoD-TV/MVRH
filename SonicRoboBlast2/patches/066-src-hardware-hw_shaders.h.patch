+// VR underwater. Three world-space layers, all keyed off the eye being
+// submerged (vr_uwfog > 0; flat play and dry eyes compile the blocks away):
+//
+// 1. CAUSTICS -- two interfering wave sets sharpened into bright filaments,
+//    anchored to world position so they dance across floors and walls,
+//    strongest near the surface and dying with depth below it.
+// 2. HEIGHT-GRADED WATER COLUMN -- the Beer-Lambert ambient glows near the
+//    surface (sunlight in the water) and falls toward the abyss below it, so
+//    the fog itself carries the up-bright / down-dark truth of open water.
+// 3. ABSORPTION -- per-channel exponential falloff toward that ambient: red
+//    dies within meters, green holds longer, blue longest.
+//
+// Two water judges, deliberately split: vr_uwsurf is the surface of the water
+// the EYE is inside (the medium -- absorption fog, god rays, Snell's window),
+// while vr_uwlocal is the water top of the DRAWN SURFACE's own sector, fed
+// per-draw through FSurfaceInfo. The seen-through-the-surface layers
+// (caustics, shore depth-blueing) key off vr_uwlocal, so they follow each
+// water body exactly: no pop-in when the viewer changes sector, no dapple
+// bleeding onto dry rooms that merely sit below some other lake's waterline.
+// vr_eyepos is the rendering eye; all heights/positions in world units
+// (shader axes: x = map x, y = height, z = map y).
+// Per-layer strengths (all 0 = everything compiles away, flat play included):
+// vr_uwfog = absorption density (nonzero only while the EYE is submerged),
+// vr_uwcaustic = caustic brightness (on whenever the atmosphere option is --
+// vr_uwlocal gates where it lands), vr_uwray = god rays (submerged eye only).
+#define GLSL_VR_UNDERWATER_UNIFORMS \
+	"uniform float vr_uwfog;\n" \
+	"uniform vec3 vr_uwcolor;\n" \
+	"uniform float vr_uwsurf;\n" \
+	"uniform float vr_uwlocal;\n" \
+	"uniform vec3 vr_eyepos;\n" \
+	"uniform float vr_uwcaustic;\n" \
+	"uniform float vr_uwcaustictime;\n" \
+	"uniform float vr_uwray;\n" \
+	"varying vec3 world_pos;\n"
+
+#define GLSL_VR_UNDERWATER_FOG \
+	"if (vr_uwcaustic > 0.0 && vr_uwlocal != 0.0 && world_pos.y < vr_uwlocal + 48.0) {\n" \
+		"float subs = clamp((vr_uwlocal - world_pos.y) * 0.0035, 0.0, 1.0);\n" \
+		/* No hard stop at the waterline: the dapple runs a short band above  */ \
+		/* the surface and fades out, the way light plays on a pool's walls.  */ \
+		"float cband = smoothstep(0.0, 1.0, clamp((vr_uwlocal + 48.0 - world_pos.y) / 48.0, 0.0, 1.0));\n" \
+		/* One sunlight budget for every lit-water layer: nearness to the  */ \
+		/* surface, times how bright the map itself lit this spot -- so    */ \
+		/* authored dark caves stay dark and sunny shallows sparkle, and   */ \
+		/* caustics and rays rise and fall together instead of competing.  */ \
+		/* smoothstep saturates at 55% light: animated and strobing sector  */ \
+		/* lights swing the lighting uniform every frame, and multiplying   */ \
+		/* the caustics by it made whole sectors - props included - pulse   */ \
+		/* in time. Above the cap the caustic strength is constant, so      */ \
+		/* light animation cannot reach it; dark areas still fade out.      */ \
+		"float uwsun = (1.0 - 0.75 * subs) * (0.30 + 0.70 * smoothstep(0.0, 0.55, clamp(lighting / 255.0, 0.0, 1.0)));\n" \
+		/* BOTH wave domains key to world position and nothing else. The     */ \
+		/* texcoord domain that lived here slid every frame on scrolling     */ \
+		/* surfaces (waterfalls, flowing water flats) - and those sit        */ \
+		/* exactly where this layer is live. Flat, the animated clock hides  */ \
+		/* that slide; in VR the clock is frozen, so the slide was the only  */ \
+		/* motion left and the dapple crawled and shimmered. World position  */ \
+		/* is static for level geometry, so the pattern now is too. Two      */ \
+		/* scales with a skewed axis keep the interference varied enough     */ \
+		/* that no plane starves into a flat field.                          */ \
+		"vec2 cpA = vec2(world_pos.x * 0.043 + world_pos.z * 0.029, world_pos.z * 0.047 - world_pos.x * 0.031);\n" \
+		"vec2 cpB = world_pos.xz * 0.05;\n" \
+		/* Smooth interference field with NO clamp: the old form saturated   */ \
+		/* into flat plateaus of pure 0/1, and on coarse surfaces a whole    */ \
+		/* plane sat inside one plateau and blinked as the waves drifted     */ \
+		/* through the clamp edge - the whole-surface flash. cos() of a      */ \
+		/* smooth sum is bounded and never flat, so it can only dapple.      */ \
+		"float cwa = sin(cpA.x + vr_uwcaustictime * 1.1519173) + sin(cpA.y * 0.87 - vr_uwcaustictime * 0.9424778);\n" \
