+//
+// World vertex shader: the generic one plus the VR underwater sway. Geometry
+// drifts on slow waves keyed to WORLD position, so the scene undulates
+// coherently and both eyes see the same displaced world with true parallax --
+// the stereo-correct stand-in for the flat screen's warp. Two incommensurate
+// wavelengths and periods so the motion never reads as a loop. vr_sway is the
+// amplitude in world units; at the default 0 the path is the identity.
+// Used by the world-geometry programs only (floor/wall/sprite/water/fog) --
+// the sky dome and UI never sway.
+//
+
+#define GLSL_WORLD_VERTEX_SHADER \
+	"uniform float vr_sway;\n" \
+	"uniform float leveltime;\n" \
+	"varying vec3 world_pos;\n" \
+	"void main()\n" \
+	"{\n" \
+		"vec4 v = gl_Vertex;\n" \
+		"if (vr_sway > 0.0)\n" \
+		"{\n" \
+			"float ph  = (v.x + v.z) * 0.028 + leveltime * 1.3;\n" \
+			"float ph2 = (v.x - v.z) * 0.017 - leveltime * 0.9;\n" \
+			"v.x += (sin(ph) + 0.6 * sin(ph2)) * vr_sway;\n" \
+			"v.z += (cos(ph2) + 0.5 * cos(ph * 0.7)) * vr_sway * 0.8;\n" \
+			"v.y += (sin(ph * 0.6 + 1.7) + 0.5 * sin(ph2 * 1.4)) * vr_sway * 0.45;\n" \
+		"}\n" \
+		"world_pos = v.xyz;\n" \
+		"gl_Position = gl_ProjectionMatrix * gl_ModelViewMatrix * v;\n" \
+		"gl_FrontColor = gl_Color;\n" \
+		"gl_TexCoord[0].xy = gl_MultiTexCoord0.xy;\n" \
+		"gl_ClipVertex = gl_ModelViewMatrix * v;\n" \
+	"}\0"
