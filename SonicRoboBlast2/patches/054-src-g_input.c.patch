+	// Configs from before exec minor 4 carry the old LB = Chase Toggle pad
+	// default; drop exactly that binding so the shoulder button stops
+	// flipping the camera. Any hand-picked key passes through untouched.
+	if (numctrl == GC_CAMTOGGLE && GETMINOREXECVERSION(cv_execversion.value) < 4)
