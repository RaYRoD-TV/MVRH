+			if (*keynum2 && *keynum2 != oldpad)
+			{
+				*keynum1 = *keynum2; // shift down keynum2 and continue
+				*keynum2 = 0;
+			}
+			else
+				return -1; // skip setting control
+		}
+		else if (keyidx == 1 && *keynum2 == oldpad)
+			return -1; // skip setting control
+	}
