+// ---- VR underwater feel ----
+// The flat game's screen-space water warp can't run in the eyes (it white-outs
+// under MSAA and double-visions without it), so VR sells "submerged" with
+// stereo-correct world-space layers instead: a distance haze pushed into every
+// surface's fade band here, plus a full-eye veil drawn in HWR_DoPostProcessor.
+// The test runs at the EYE's position (the view globals are eye-true in VR),
+// so at the surface each eye crosses the waterline independently -- lean down
+// and the water climbs over your face one eye at a time, like the real thing.
+static boolean gl_vrEyeUnderwater = false;
+static float gl_vrEyeWaterDepth = 0.0f; // 0 at the surface -> 1 deep (haze strength)
+static float gl_vrEyeShallow = 1.0f;    // eases the submerged layers in over the first ~0.4 m
+static fixed_t gl_vrEyeWaterTop = 0;    // surface height of the water the eye is in
+
+static void HWR_ScanVREyeWater(void)
+{
+	sector_t *sector;
+	ffloor_t *rover;
+
+	gl_vrEyeUnderwater = false;
+	// Flatscreen gets the full stack too (the classic screen warp stays on
+	// top of it there); only the world sway remains VR-only, since the warp
+	// already gives flat its wobble.
+	if (!cv_vrwateratmo.value)
+		return;
+
+	sector = R_PointInSubsector(viewx, viewy)->sector;
+	for (rover = sector->ffloors; rover; rover = rover->next)
+	{
+		fixed_t topheight, bottomheight;
+		float s, depth;
+
+		if (!(rover->fofflags & FOF_EXISTS) || !(rover->fofflags & FOF_SWIMMABLE)
+			|| rover->fofflags & FOF_BLOCKPLAYER)
+			continue;
+
+		topheight    = P_GetFFloorTopZAt   (rover, viewx, viewy);
+		bottomheight = P_GetFFloorBottomZAt(rover, viewx, viewy);
+
+		if (viewz >= topheight || viewz <= bottomheight)
+			continue;
+
+		gl_vrEyeUnderwater = true;
+		gl_vrEyeWaterTop = topheight;
+		// Haze reaches full strength about ten meters down.
+		s = (float)atof(cv_vrscale.string);
+		if (s < 1.0f) s = 32.0f;
+		depth = FixedToFloat(topheight - viewz) / (10.0f * s);
+		gl_vrEyeWaterDepth = min(max(depth, 0.0f), 1.0f);
+		// Crossing the waterline snapped the fog/rays/veil on at full
+		// strength; easing them over the first ~0.4 m keeps each eye's own
+		// crossing (the per-eye waterline sweep stays) without the pop.
+		depth = FixedToFloat(topheight - viewz) / (0.4f * s);
+		gl_vrEyeShallow = min(max(depth, 0.0f), 1.0f);
+		return;
+	}
+
+	// Dry eye. Clear the surface reference as well: HWD_SHADERINFO_VRUWSURF is
+	// sent UNCONDITIONALLY, so leaving the last swim's water top standing fed
+	// a surface height that is no longer there into the eye column's depth
+	// term, and it changed every time the head dipped in or out. The
+	// seen-through-the-surface layers (caustics, shore blueing) are unaffected
+	// -- they don't care where the EYE stands, because every drawn surface
+	// carries its own sector's water top (HWR_SurfWaterTop).
+	gl_vrEyeWaterTop = 0;
+}
+
+// Waterline trace, "vr_waterdebug on". The remaining VR-only flashing suspect
+// is the two eyes disagreeing: the scan above runs off viewx/viewy/viewz, and
+// those differ per eye, so near the surface one eye can read submerged while
+// the other reads dry. That gives one image full fog and the other none, which
+// is binocular rivalry -- it reads as a flash, and it cannot happen flat.
+// Events are COUNTED and reported once a second, never printed as they
+// happen. Printing per event costs more than the thing being measured: at
+// headset framerate a state that flips every frame means a console write every
+// frame, which drops frames -- and a dropped frame in VR reads as a flash. A
+// chatty probe manufactures the exact symptom it was added to find. Rates are
+// the better evidence anyway: "SPLIT 90/s" and "SPLIT 0" are different bugs.
+static void HWR_LogVREyeWater(void)
+{
+	static boolean under[2];
+	static float shallow[2], depth[2];
+	static fixed_t top[2];
+	static boolean lastUnder;
+	static UINT32 nframe, nsplit, nflip, window;
+	const INT32 e = (g_vrActive && g_vrEyeIndex == 1) ? 1 : 0;
+
+	if (!cv_vrwaterdebug.value)
+		return;
+
+	under[e]   = gl_vrEyeUnderwater;
+	shallow[e] = gl_vrEyeShallow;
+	depth[e]   = gl_vrEyeWaterDepth;
+	top[e]     = gl_vrEyeWaterTop;
+
+	// Flat has one eye and tallies immediately; in stereo wait for the right
+	// eye so both halves of the comparison come from the same frame.
+	if (g_vrActive && e != 1)
+		return;
+
+	nframe++;
+	if (g_vrActive && under[0] != under[1])
+		nsplit++;
+	if (under[0] != lastUnder)
+	{
+		lastUnder = under[0];
+		nflip++;
+	}
+
+	if (leveltime - window < TICRATE)
+		return;
+	window = leveltime;
+
+	CONS_Printf("\x83""VR water\x80 %u frames  SPLIT %u  FLIP %u  under L=%d R=%d  "
+		"shallow %.3f/%.3f  depth %.3f/%.3f  top %d/%d\n",
+		nframe, nsplit, nflip, under[0], under[1],
+		shallow[0], shallow[1], depth[0], depth[1],
+		top[0] >> FRACBITS, top[1] >> FRACBITS);
+	nframe = nsplit = nflip = 0;
+}
+
+static void HWR_CheckVREyeWater(void)
+{
+	// ONE water verdict per frame, taken from the left eye and reused for the
+	// right. The scan reads viewx/viewy/viewz, which differ per eye, so near
+	// the surface the two eyes straddle the waterline and disagree: one image
+	// gets the full fog stack and the other gets none. Those cannot fuse, and
+	// the pair alternating frame to frame is the colour-shift flash.
+	//
+	// This is the same call the eye-anchored underwater math already makes for
+	// its origin a few hundred lines below -- one shared verdict beats two
+	// individually-correct ones that fight each other -- and the error it
+	// accepts is a few centimeters of waterline on the right eye, which is
+	// well under the depth over which the layers ease in.
+	if (!g_vrActive || g_vrEyeIndex == 0)
+		HWR_ScanVREyeWater();
+	else if (cv_vrwaterdebug.value)
+	{
+		// Sharing the verdict would make the two eyes agree by construction
+		// and blind the SPLIT counter to the very thing it exists to prove.
+		// With the trace on, scan what the right eye WOULD have concluded,
+		// let the log see it, then put the shared verdict back so rendering
+		// is unaffected. Costs one sector lookup, and only while tracing.
+		const boolean su = gl_vrEyeUnderwater;
+		const float sd = gl_vrEyeWaterDepth, ss = gl_vrEyeShallow;
+		const fixed_t st = gl_vrEyeWaterTop;
+
+		HWR_ScanVREyeWater();
+		HWR_LogVREyeWater();
+
+		gl_vrEyeUnderwater = su;
+		gl_vrEyeWaterDepth = sd;
+		gl_vrEyeShallow = ss;
+		gl_vrEyeWaterTop = st;
+		return;
+	}
+	HWR_LogVREyeWater();
+}
+
+// Per-surface judge for the seen-through-the-surface water layers: the top of
+// the swimmable water in the DRAWN surface's own sector, in world units
+// (0 = dry sector, the shader's "off"). Judging fragment-side by the owning
+// sector -- never by the viewer's -- is what keeps the stack cohesive: a lake
+// dapples from any vantage (no pop-in crossing sector lines) and dry rooms
+// that merely sit below some other lake's waterline never catch the bleed.
+// Real water at exactly height 0 nudges up a sliver to stay distinct from
+// "none"; 1/16 world unit is invisible.
+float HWR_SurfWaterTop(sector_t *sector)
+{
+	// Draws batch by subsector, so consecutive calls overwhelmingly hit the
+	// same sector -- one memo entry absorbs the FOF walk for nearly all of
+	// the thousands of per-draw calls a frame makes.
+	static sector_t *memosec = NULL;
+	static size_t memoframe = 0;
+	static float memoval = 0.0f;
+	ffloor_t *rover;
+	fixed_t best = INT32_MIN;
+	float h;
+
+	if (!cv_vrwateratmo.value || !cv_glshaders.value || !sector)
+		return 0.0f;
+
+	if (sector == memosec && framecount == memoframe)
+		return memoval;
+
+	for (rover = sector->ffloors; rover; rover = rover->next)
+	{
+		fixed_t top;
+
+		if (!(rover->fofflags & FOF_EXISTS) || !(rover->fofflags & FOF_SWIMMABLE)
+			|| rover->fofflags & FOF_BLOCKPLAYER)
+			continue;
+
+		top = P_GetFFloorTopZAt(rover, sector->soundorg.x, sector->soundorg.y);
+		if (top > best)
+			best = top;
+	}
+
+	if (best == INT32_MIN)
+		h = 0.0f;
+	else
+	{
+		h = FixedToFloat(best);
+		if (h == 0.0f)
+			h = 0.0625f;
+	}
+
+	memosec = sector;
+	memoframe = framecount;
+	memoval = h;
+	return h;
+}
