+// VR eye-pass screen effect: draw a finished eye render (already a texture)
+// into the currently bound swapchain framebuffer through the final-blit CRT
+// shader. The plain eye path is a glBlitFramebuffer, which can run no
+// shader; this is the same quad DrawScreenFinalTexture draws, minus the
+// power-of-two screen-texture copy that path would force at headset
+// resolution (a 4096x4096 CopyTexSubImage per eye per frame).
+EXPORT void HWRAPI(DrawVREyeEffect) (UINT32 tex, int width, int height)
+{
+	float off[12];
+	float fix[8];
+
+	// Fullscreen NDC quad; the source texture is its own exact size, so the
+	// texcoords span the full 0-1 with no power-of-two correction.
+	off[0] = -1.0f; off[1]  = -1.0f; off[2]  = 1.0f;
+	off[3] =  1.0f; off[4]  = -1.0f; off[5]  = 1.0f;
+	off[6] =  1.0f; off[7]  =  1.0f; off[8]  = 1.0f;
+	off[9] = -1.0f; off[10] =  1.0f; off[11] = 1.0f;
+	fix[0] = 0.0f; fix[1] = 0.0f;
+	fix[2] = 1.0f; fix[3] = 0.0f;
+	fix[4] = 1.0f; fix[5] = 1.0f;
+	fix[6] = 0.0f; fix[7] = 1.0f;
+
+	pglViewport(0, 0, width, height);
+	SetBlend(PF_NoDepthTest);
+	pglBindTexture(GL_TEXTURE_2D, tex);
+	pglColor4ubv(white);
+
+	SetShader(screen_effect >= 2 ? SHADER_CRTMEGA : SHADER_CRTSHARP);
+	Shader_SetUniforms(NULL, NULL, NULL, NULL);
+
+	pglTexCoordPointer(2, GL_FLOAT, 0, fix);
+	pglVertexPointer(3, GL_FLOAT, 0, off);
+	pglDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+
+	UnSetShader();
+	tex_downloaded = tex;
+}
