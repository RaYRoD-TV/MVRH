+// Blend RGB as requested, but always accumulate the alpha channel as coverage
+// (ONE, ONE_MINUS_SRC_ALPHA). The window's alpha is never displayed, and the VR UI
+// overlay renders into a transparent FBO whose alpha must stay meaningful -- otherwise
+// fades/translucency write garbage alpha and the overlay blacks out the world behind it.
+static void GL_BlendFuncRGB(GLenum sfactor, GLenum dfactor)
+{
+	if (pglBlendFuncSeparate)
+		pglBlendFuncSeparate(sfactor, dfactor, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+	else
+		pglBlendFunc(sfactor, dfactor);
