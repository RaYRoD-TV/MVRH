+# OpenXR VR support (Windows only for now). Heavy logic lives in src/vr/i_openxr.c;
+# guarded by SRB2_HAVE_OPENXR so a build without the loader still links.
+if(WIN32)
+	find_package(OpenXR CONFIG QUIET)
+	if(OpenXR_FOUND)
+		target_link_libraries(SRB2SDL2 PRIVATE OpenXR::openxr_loader opengl32)
+		target_compile_definitions(SRB2SDL2 PRIVATE -DSRB2_HAVE_OPENXR)
+		message(STATUS "OpenXR found: VR support enabled")
+	else()
+		message(WARNING "OpenXR not found; building without VR support")
+	endif()
+endif()
+
 # config.h is generated by this command. It should be done at
 # build time for accurate git information and before anything
 # that needs it, obviously.
@@ -145,6 +162,22 @@ endif()
 
 target_compile_features(SRB2SDL2 PRIVATE c_std_11 cxx_std_17)
 
+# Workaround: MSVC 14.50 (Visual Studio 2026) crashes with an internal compiler error
+# (C2 backend, "RaiseException" during "Generating Code...") when optimizing SRB2's Lua
+# code under /O2 -- both the script bindings (src/lua_*.c) AND the bundled Lua interpreter
+# (src/blua/*.c). Rather than chase individual translation units, disable optimization for
+# this target on MSVC's optimized configs. This matches SRB2's own Ninja "release" preset,
+# which also forgoes /O2 (it overrides the RelWithDebInfo flags to just -DNDEBUG) -- so this
+# is upstream's release optimization level, not a downgrade. Debug is unaffected.
+# Remove this block once a future MSVC toolset fixes the optimizer crash.
+if(MSVC)
+	target_compile_options(SRB2SDL2 PRIVATE
+		$<$<CONFIG:Release>:/Od>
+		$<$<CONFIG:RelWithDebInfo>:/Od>
+		$<$<CONFIG:MinSizeRel>:/Od>
+	)
+endif()
+
