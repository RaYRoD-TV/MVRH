 #ifdef HAVE_PNG
+// libpng lives in its own DLL with its own C runtime, so a FILE* opened here
+// is meaningless once png_init_io hands it across that boundary - libpng's
+// fread saw descriptor -1 and the CRT fast-failed (0xC0000409), which is the
+// 3D models crash. Read the file on this side and give libpng bytes instead;
+// nothing then crosses the boundary but plain memory.
+typedef struct
+{
+	const UINT8 *data;
+	size_t size;
+	size_t pos;
+} png_memsrc_t;
+
+static void PNG_MemRead(png_structp png_ptr, png_bytep out, png_size_t count)
+{
+	png_memsrc_t *src = (png_memsrc_t *)png_get_io_ptr(png_ptr);
+
+	if (src == NULL || src->pos + count > src->size)
+	{
+		png_error(png_ptr, "PNG_MemRead: read past end of buffer");
+		return;
+	}
+
+	M_Memcpy(out, src->data + src->pos, count);
+	src->pos += count;
+}
+
+// Scratch buffer for the above, grown as needed and kept for the process's
+// life. Deliberately not per-call: this function sits behind a setjmp, and a
+// local allocation would need volatile handling on every error path.
+static UINT8 *png_filebuf = NULL;
+static size_t png_filebufsize = 0;
+static png_memsrc_t png_memsrc;
+
 static void PNG_error(png_structp PNG, png_const_charp pngtext)
 {
 	CONS_Debug(DBG_RENDER, "libpng error at %p: %s", PNG, pngtext);
