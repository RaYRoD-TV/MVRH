+static inline boolean P_CanZMove(mobj_t *mobj)
+{
+	return (!(mobj->eflags & MFE_ONGROUND) || mobj->momz
+	|| ((mobj->eflags & MFE_VERTICALFLIP) && mobj->z + mobj->height != mobj->ceilingz)
+	|| (!(mobj->eflags & MFE_VERTICALFLIP) && mobj->z != mobj->floorz)
