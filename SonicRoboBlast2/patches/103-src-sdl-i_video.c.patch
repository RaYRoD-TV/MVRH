+	event_t event;
+	SDL_JoystickID joyid[2];
+
+	joyid[0] = SDL_JoystickInstanceID(JoyInfo.dev);
+	joyid[1] = SDL_JoystickInstanceID(JoyInfo2.dev);
+
+	if (evt.which == joyid[0] && JoyInfo.gamepad)
+		event.type = ev_joystick;
+	else if (evt.which == joyid[1] && JoyInfo2.gamepad)
+		event.type = splitscreen ? ev_joystick2 : ev_joystick;
+	else return;
+
+	// The controller axis order -- LX LY RX RY LT RT -- is the order the
+	// joyaxis_* defaults were written for, so the raw pair math carries over.
+	if (evt.axis >= JOYAXISSET*2)
+		return;
+	event.key = evt.axis / 2;
+	event.x = event.y = INT32_MAX; // untouched component keeps its last value
+	if (evt.axis % 2)
+		event.y = SDLJoyAxis(evt.value, event.type);
+	else
+		event.x = SDLJoyAxis(evt.value, event.type);
+	D_PostEvent(&event);
+}
