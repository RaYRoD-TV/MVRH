+static UINT32 mergedjoydown[2], mergedhatdown[2];
+
+static boolean MergedButtonEdge(UINT32 *masks, int slot, int bit, boolean down)
+{
+	UINT32 before = (masks[0] | masks[1]) & ((UINT32)1 << bit);
+	UINT32 after;
+	if (down)
+		masks[slot] |= ((UINT32)1 << bit);
+	else
+		masks[slot] &= ~((UINT32)1 << bit);
+	after = (masks[0] | masks[1]) & ((UINT32)1 << bit);
+	return before != after;
+}
