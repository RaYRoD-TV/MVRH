+static void Impl_HandleControllerButtonEvent(SDL_ControllerButtonEvent evt, Uint32 type)
+{
+	event_t event;
+	SDL_JoystickID joyid[2];
+	boolean secondslot = false;
+	INT32 index;
+
+	// Instance IDs match the joystick opened for the same device.
+	joyid[0] = SDL_JoystickInstanceID(JoyInfo.dev);
+	joyid[1] = SDL_JoystickInstanceID(JoyInfo2.dev);
+
+	if (evt.which == joyid[0] && JoyInfo.gamepad)
+		secondslot = false;
+	else if (evt.which == joyid[1] && JoyInfo2.gamepad)
+		secondslot = true;
+	else return;
+
+	if (type == SDL_CONTROLLERBUTTONUP)
+		event.type = ev_keyup;
+	else if (type == SDL_CONTROLLERBUTTONDOWN)
+		event.type = ev_keydown;
+	else return;
+
+	switch (evt.button)
+	{
+		// D-pad: the hat the defaults bind (menus read it as arrows).
+		case SDL_CONTROLLER_BUTTON_DPAD_UP:
+			index = 0; goto hat;
+		case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
+			index = 1; goto hat;
+		case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
+			index = 2; goto hat;
+		case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
+			index = 3;
+		hat:
+			// Second-slot pads are player 1's outside splitscreen (see the
+			// axis handler above).
+			if (secondslot && splitscreen)
+				event.key = KEY_2HAT1 + index;
+			else if (MergedButtonEdge(mergedhatdown, secondslot ? 1 : 0, index, event.type == ev_keydown))
+				event.key = KEY_HAT1 + index;
+			else
+				return;
+			break;
+		default:
+			index = ControllerButtonIndex(evt.button);
+			if (index < 0)
+				return;
+			if (secondslot && splitscreen)
+				event.key = KEY_2JOY1 + index;
+			else if (MergedButtonEdge(mergedjoydown, secondslot ? 1 : 0, index, event.type == ev_keydown))
+				event.key = KEY_JOY1 + index;
+			else
+				return;
+			break;
+	}
+
+	D_PostEvent(&event);
+}
