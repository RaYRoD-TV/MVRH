+	*h = dm.h;
+	return true;
+}
+
+boolean VID_GetWindowedDefault(INT32 *w, INT32 *h)
+{
+	// The biggest listed mode that leaves real margins around a window
+	// (~60% of the desktop each way). The window is created at exactly the
+	// mode size in windowed play, so the render resolution always matches it.
+	INT32 dw, dh, i;
+	if (!VID_GetNativeSize(&dw, &dh))
+		return false;
+	for (i = 0; i < MAXWINMODES; i++)
+	{
+		if (windowedModes[i][0] * 5 <= dw * 3 && windowedModes[i][1] * 5 <= dh * 3)
+		{
+			*w = windowedModes[i][0];
+			*h = windowedModes[i][1];
+			return true;
+		}
+	}
+	return false;
+}
