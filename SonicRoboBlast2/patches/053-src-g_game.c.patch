+// VR "move where you look": rotate a stick's axis pair by the head yaw
+// (degrees, counter-clockwise-positive -- the same number the renderer adds to
+// the camera). The pair reads as side = +xaxis, forward = -yaxis, so rotating
+// (xaxis, yaxis) by that angle rotates the control DIRECTION by it. Zero
+// degrees leaves the pair untouched, which is the stock body-relative feel.
+static void G_VRHeadRelativeMove(joystickvector2_t *joystickvector, float headyaw)
+{
+	angle_t a;
+	fixed_t c, s;
+	INT32 x, y;
+
+	if (headyaw == 0.0f)
+		return;
+
+	a = FixedAngle(FLOAT_TO_FIXED(headyaw));
+	c = FINECOSINE(a >> ANGLETOFINESHIFT);
+	s = FINESINE(a >> ANGLETOFINESHIFT);
+	x = joystickvector->xaxis;
+	y = joystickvector->yaxis;
+	joystickvector->xaxis = FixedMul(x, c) + FixedMul(y, s);
+	joystickvector->yaxis = FixedMul(y, c) - FixedMul(x, s);
+}
