+// Scroll menu plus a live readout while World Scale is selected: the scale as
+// "how big the world feels" vs the default, updating while the slider is
+// dragged (the world behind the floating menu rescales in step, so the change
+// is visible). Drawn under the scroll area (2 x the 72-row scrollareaheight).
+static void M_DrawVROptions(void)
+{
+	M_DrawGenericScrollMenu();
+
+	if (currentMenu->menuitems[itemOn].itemaction == (void *)&cv_vrscale)
+	{
+		float s = (float)atof(cv_vrscale.string);
+		float def = (float)atof(cv_vrscale.defaultvalue);
+		if (s < 1.0f)
+			s = def;
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 12, V_YELLOWMAP,
+			va("World feels x%.2f its normal size", def/s));
+	}
+	else if (currentMenu->menuitems[itemOn].itemaction == (void *)&cv_vrheadmove)
+	{
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 4, V_YELLOWMAP,
+			cv_vrheadmove.value ? "Forward is where your head faces,"
+			                    : "Forward is where your body faces,");
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 12, V_YELLOWMAP,
+			cv_vrheadmove.value ? "not where the turn stick left you."
+			                    : "set by the turn stick.");
+	}
+	else if (currentMenu->menuitems[itemOn].itemaction == (void *)&cv_vrsnapturn)
+	{
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 4, V_YELLOWMAP,
+			cv_vrsnapturn.value ? va("Turning cuts %d degrees per flick.", cv_vrsnapturn.value)
+			                    : "Turning sweeps with the stick.");
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 12, V_YELLOWMAP,
+			cv_vrsnapturn.value ? "No sweep to feel: easier on the stomach."
+			                    : "Steps instead of sweeping settle queasiness.");
+	}
+	else if (currentMenu->menuitems[itemOn].itemaction == (void *)&cv_vrunlockall)
+	{
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 4, V_YELLOWMAP,
+			"Opens all levels & secrets.");
+		V_DrawString(currentMenu->x, currentMenu->y + 144 + 12, V_YELLOWMAP,
+			"Medals & records pause 'til restart.");
+	}
+}
