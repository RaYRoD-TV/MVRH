+// VR: the grips hop between menu sections (the yellow headers), so long
+// scroll menus page in one squeeze. Menus without headers hop to top/bottom.
+void M_MenuSectionJump(INT32 dir)
+{
+	INT16 i;
+	INT16 target = -1;
+
+	if (!menuactive)
+		return;
+	if (dir > 0)
+	{
+		for (i = itemOn + 1; i < currentMenu->numitems; i++)
+			if ((currentMenu->menuitems[i].status & IT_DISPLAY) == IT_HEADERTEXT)
+			{ target = i; break; }
+		if (target < 0)
+			target = currentMenu->numitems - 1; // no section below: bottom
+	}
+	else
+	{
+		i = itemOn - 1;
+		// standing at a section's first item: hop over its own header
+		if (i >= 0 && (currentMenu->menuitems[i].status & IT_DISPLAY) == IT_HEADERTEXT)
+			i--;
+		for (; i >= 0; i--)
+			if ((currentMenu->menuitems[i].status & IT_DISPLAY) == IT_HEADERTEXT)
+			{ target = i; break; }
+		if (target < 0)
+			target = 0; // no section above: top
+	}
+	itemOn = target;
+	// Headers and spacers are not selectable: settle on the next real item.
+	if ((currentMenu->menuitems[itemOn].status & IT_TYPE) & IT_SPACE)
+		M_NextOpt();
+	else
+		M_UpdateItemOn();
+	S_StartSound(NULL, sfx_menu1);
+}
