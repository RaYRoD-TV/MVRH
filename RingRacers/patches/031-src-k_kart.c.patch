+	// below neutral it stands down entirely. Local rules only, and loop
+	// setpieces keep their own momentum handling.
+	if (cv_drifthandling.value > 50
+		&& player->drift != 0
+		&& player->loop.radius == 0
+		&& netgame == false && demo.playback == false
+		&& K_PlayerUsesBotMovement(player) == false)
+	{
+		const fixed_t dspeed = FixedHypot(player->mo->momx, player->mo->momy);
+
+		if (dspeed > 0)
+		{
+			const angle_t momdir = R_PointToAngle2(0, 0, player->mo->momx, player->mo->momy);
+			const INT32 delta = AngleDeltaSigned(player->mo->angle, momdir);
+			const INT32 step = ((ANG1*3) / 50) * (cv_drifthandling.value - 50);
+			angle_t newdir;
+
+			if (delta > step)
+				newdir = momdir + step;
+			else if (delta < -step)
+				newdir = momdir - step;
+			else
+				newdir = player->mo->angle;
+
+			player->mo->momx = FixedMul(dspeed, FINECOSINE(newdir >> ANGLETOFINESHIFT));
+			player->mo->momy = FixedMul(dspeed, FINESINE(newdir >> ANGLETOFINESHIFT));
+		}
+	}
