+	// exactly once; road bumps stay under the airtime bar, trick landings
+	// have their own reward, and a hit landing pays nothing.
+	if (K_LandingDashActive()
+		&& onground == true && player->airtime == 0
+		&& player->lastairtime >= 5
+		&& player->landdash == 0
+		&& player->trickpanel == TRICKSTATE_NONE
+		&& player->respawn.state == RESPAWNST_NONE
+		&& player->spinouttimer == 0 && player->tumbleBounces == 0
+		&& !P_PlayerInPain(player))
+	{
+		// Five tics of air is any real hop (ground-to-ground collision
+		// noise is one tic), so nearly every jump qualifies. A landing
+		// re-ups a boost already running rather than being swallowed by
+		// it - chained crests keep paying.
+		player->lastairtime = 0;
+
+		if (cmd->buttons & BT_ACCELERATE)
+		{
+			S_StartSound(player->mo, sfx_s23c);
+			player->dropdashboost = max(player->dropdashboost, LANDDASHBOOST);
+			K_SpawnDashDustRelease(player);
+		}
+		else
+		{
+			player->landdash = LANDDASHWINDOW;
+		}
+	}
+
+	// Air tricks anywhere. Real air plus the drift button arms the trick
+	// machinery exactly as a trick panel would; the input assist then walks
+	// the arming dance and fires it straight forward. Local rules only,
+	// like every assist - it changes the simulation. Springs and panels
+	// arm themselves and are left alone.
+	// No trick live means no grant to remember. Clearing here, before the
+	// grant below can set it, is what keeps a panel's or a spring's trick
+	// unmarked - they arm elsewhere and never come through this door.
+	if (player->trickpanel == TRICKSTATE_NONE)
+	{
+		K_SetAirGrantedTrick(player, false);
+	}
+
+	if (K_TrickAssistActive()
+		&& onground == false
+		&& player->airtime >= TICRATE/4
+		&& player->trickpanel == TRICKSTATE_NONE
+		&& !(player->pflags & PF_TRICKDELAY)
+		&& player->respawn.state == RESPAWNST_NONE
+		&& player->spinouttimer == 0 && player->tumbleBounces == 0
+		&& !P_PlayerInPain(player)
+		&& (cmd->buttons & BT_DRIFT))
+	{
+		// No arming ceremony: the panels' delay exists to catch accidental
+		// inputs, and this trick IS the input - the press asked for it, so
+		// it arms already past the delay bar and fires on the spot instead
+		// of flashing the get-ready state first.
+		player->trickpanel = TRICKSTATE_READY;
+		player->tricktime = TRICKDELAY;
+		K_SetAirGrantedTrick(player, true);
+		// Same payout seed as a panel: only speed past your cap charges it.
+		player->trickboostpower = max(FixedDiv(player->speed, K_GetKartSpeed(player, false, false)) - FRACUNIT, 0)*125/100;
