+	// "Handling": how tightly the kart holds its line versus how much it
+	// slides. Friction here is a momentum multiplier, so a LOWER value bites
+	// harder into a slide and a higher one lets the back end wander - the very
+	// same lever the bot code above uses to help them corner without drifting.
+	//
+	// Bots keep their own tuning, and like the hazard rules this stands down
+	// online and in replays: it changes the simulation, so a stock client
+	// would desync rather than disagree politely.
+	if (cv_handling.value != 50
+		&& netgame == false && demo.playback == false
+		&& K_PlayerUsesBotMovement(player) == false)
+	{
+		// Either end is worth about a thirty-second of friction, matching the
+		// size of the game's own handling nudges.
+		frict -= ((cv_handling.value - 50) * (FRACUNIT >> 5)) / 50;
+	}
+
+	// Drift grip, on top of the above and only while actually drifting. A
+	// drift is where the back end is meant to come loose, so it gets its own
+	// knob rather than riding the general one - you can want a loose car that
+	// still plants itself through a drift, or the reverse. Worth DOUBLE the
+	// general lever at full: the drift is exactly where the control was
+	// missing, and the bots' own corrective grip reaches an eighth, so a
+	// sixteenth for a deliberate player setting is still conservative.
+	if (cv_drifthandling.value != 50
+		&& player->drift != 0
+		&& netgame == false && demo.playback == false
+		&& K_PlayerUsesBotMovement(player) == false)
+	{
+		frict -= ((cv_drifthandling.value - 50) * (FRACUNIT >> 4)) / 50;
+	}
+
 	if (frict > FRACUNIT) { frict = FRACUNIT; }
 	if (frict < 0) { frict = 0; }
 
