+consvar_t cv_vr_worldeffect = Player("vr_worldeffect", "On").on_off().save().onchange(VrWorldEffect_OnChange);
+consvar_t cv_vr_worldscale = Player("vr_worldscale", "16").min_max(8, 128).onchange(VrWorldScale_OnChange);
