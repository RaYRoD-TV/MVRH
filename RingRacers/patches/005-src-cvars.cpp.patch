+// VR (OpenXR). The onchange handlers live in vr/vr_cvars.c and push each
+// value into the VR module, which applies it live; distances store as
+// centimeters and scales as percent so everything stays an integer slider.
+void VrDepthLayer_OnChange(void);
+void VrDiorama_OnChange(void);
+void VrFpEyeHeight_OnChange(void);
+void VrFpForward_OnChange(void);
