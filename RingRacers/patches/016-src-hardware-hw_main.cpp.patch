+// quad and its depth are exonerated outright and the cause has to be in how VR
+// presents an identical quad - which is a different half of the search.
+static inline boolean vr_shadow_flatparity(void)
+{
+	return vr_stereo_active() && cv_vr_shadowtest.value == 2;
