+// The yaw the composed eye view adds on top of the game camera's. Zero flat,
+// and zero on the panel path. This is where the eyes are LOOKING, which is a
+// different question from where they ARE - the only caller left is the
+// behind-you test, which genuinely wants a gaze direction. Anything that
+// orients an object toward the viewer wants the eye's position instead, and
+// asks HWR_BillboardYaw.
+static angle_t HWR_EyeYawDelta(void)
+{
+	if (!vr_stereo_active())
+		return 0;
+
+	const double turn = (double)vr_billboard_yaw_delta() * (4294967296.0 / 6.283185307179586);
+	return (angle_t)(INT64)turn;
+}
+
+// How far in front of the EYES a world point sits, for the "behind the view
+// plane, throw it away" test.
+//
+// Flat, that is the camera's own plane and this is the depth the caller
+// already worked out. In VR it is not: first person looks out from the kart's
+// head, a whole chase length up the track, and free-look turns the head off
+// the camera's axis in every mode - so things alongside and just behind the
+// kart read as "behind you" and get dropped, then pop back in when the camera
+// catches up. Measured from the eye instead, the same simple rule is right
+// again in every mode.
+//
+// Note the test STAYS. Dropping it in VR (an earlier attempt) projects every
+// sprite in the level, and the vissprite budget is finite - past it sprites
+// silently stop being drawn, so removing one cull made whole objects vanish.
+static float HWR_EyeDepth(float wx, float wy, float camdepth)
+{
+	if (!vr_stereo_active())
+		return camdepth;
+
+	// The eye's forward is the camera's yaw plus whatever the composed view
+	// adds - the kart's heading in first person, plus the head's free-look.
+	// One shared value, so both eyes agree on what is behind them.
+	const angle_t look = viewangle + HWR_EyeYawDelta();
+	const float fc = FIXED_TO_FLOAT(FINECOSINE(look >> ANGLETOFINESHIFT));
+	const float fs = FIXED_TO_FLOAT(FINESINE(look >> ANGLETOFINESHIFT));
+
+	return ((wx - gl_eyex) * fc) + ((wy - gl_eyey) * fs);
+}
+
+// The yaw a billboard should square up to.
+//
+// Flat, every card in the level spans across one shared direction - the way
+// the camera faces - and at a monitor's narrow field of view that is close
+// enough to facing you. A headset's field of view is not narrow. A card at the
+// edge of vision is turned up to fifty degrees away from the eye looking at
+// it, which foreshortens the picture and rakes the card away in depth while
+// the picture painted on it still says "I am a ring, face on". Two depth
+// stories about one object is what reads as cross-eyed, and it is worst on the
+// near, busy things - rings, and racers whose skin has no model.
+//
+// Worse, tying cards to a DIRECTION means anything that swings the camera
+// swings every card in the level with it. The race-start fly-in orbits five
+// hundred and sixty degrees in three seconds; on a monitor the cards turn with
+// the camera and you never notice, but in the headset your head is still, so
+// the whole world's sprites visibly spin in place.
+//
+// So in stereo a card faces the eye POSITION instead: square to the line from
+// the head to that particular sprite. Skew goes to zero everywhere in vision,
+// a camera spin turns nothing, and free-look turns nothing either - the card
+// was already facing you. One shared head position, never a per-eye one, so
+// both eyes still get the same card.
+static angle_t HWR_BillboardYaw(fixed_t wx, fixed_t wy)
+{
+	if (!vr_stereo_active())
+		return viewangle;
+
+	return R_PointToAngle2(dup_eyex, dup_eyey, wx, wy);
+}
