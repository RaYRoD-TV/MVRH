+// The synthetic VR gamepad has no SDL handle; route its rumble to the motion
+// controllers instead. The game re-issues rumble every tic while a condition
+// holds and sends explicit zeroes to stop, so the duration below is only a
+// safety net against a lost stop.
+static boolean VrRumbleShim(INT32 device_id, UINT16 a, UINT16 b)
+{
+	if (device_id != VR_GAMEPAD_DEVICE_ID)
+	{
+		return false;
+	}
+
+	UINT16 strength = (a > b) ? a : b;
+	if (strength == 0)
+	{
+		vr_controller_rumble_stop();
+	}
+	else
+	{
+		vr_controller_rumble((float)strength / 65535.0f, 0.25f);
+	}
+	return true;
+}
+
