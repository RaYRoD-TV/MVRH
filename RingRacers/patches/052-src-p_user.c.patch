+// Drive the chase camera to where the current settings say it belongs, right
+// now, without waiting for a tic that isn't coming. The view sliders live in
+// the pause menu, and the camera is frozen while that menu is up, so without
+// this a knob like Camera Forward reads as broken: you drag it, nothing moves,
+// and the change only appears once you close the menu and unpause.
+//
+// The camera eases toward its ideal spot one step per call, so this repeats
+// until the step lands on it - the same converge-by-repetition P_ResetCamera
+// uses, and cheap enough at a few dozen iterations for a one-off knob edit.
+// Purely local presentation: camera_t is never networked.
+void P_UpdateCamerasNow(void)
+{
+	UINT8 i;
+
+	if (gamestate != GS_LEVEL || camerarunwhilepaused)
+		return;
+
+	camerarunwhilepaused = true;
+
+	for (i = 0; i <= r_splitscreen; i++)
+	{
+		player_t *p = &players[displayplayers[i]];
+		camera_t *cam = &camera[i];
+		tic_t tries = 0;
+
+		// The same cameras P_ResetCamera refuses to touch: a free/spectator
+		// camera is flown by hand and the end-of-race camera is on rails, and
+		// running either from here would hand it a movement step built from
+		// whatever input was last held before the menu opened.
+		if (!cam->chase || !p->mo || cam->freecam || p->spectator || g_endcam.active)
+			continue;
+
+		while (!P_MoveChaseCamera(p, cam, false) && ++tries < 2*TICRATE);
+	}
+
+	camerarunwhilepaused = false;
+}
