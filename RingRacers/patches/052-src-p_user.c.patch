+// The VR view-mode cvar, driven without a headset: FIRST_PERSON and DIORAMA
+// reshape the flat chase camera in P_MoveChaseCamera, THEATER means nothing
+// on a monitor and renders stock. While a headset session runs the VR module
+// composes the modes itself, so the flat camera stays stock third person.
+extern consvar_t cv_vr_viewmode, cv_vr_fp_eyeheight, cv_vr_fp_forward, cv_vr_tp_forward;
+
+INT32 P_FlatViewMode(void)
+{
+	if (vr_is_active())
+		return VR_VIEW_THIRD_PERSON;
+
+	switch (cv_vr_viewmode.value)
+	{
+		case VR_VIEW_FIRST_PERSON:
+		case VR_VIEW_DIORAMA:
+			return cv_vr_viewmode.value;
+		default:
+			return VR_VIEW_THIRD_PERSON;
+	}
+}
+
+// D-pad up walks third person -> first person -> diorama. Theater stays a
+// headset-only screen, and first person is skipped (not blocked) while the
+// pre-race countdown runs - the same manners as the VR stick-click cycle,
+// which takes over entirely once a session is live.
+void P_CycleFlatViewMode(void)
+{
+	INT32 next;
+
+	if (vr_is_active())
+	{
+		vr_cycle_view_mode();
+		return;
+	}
+
+	next = cv_vr_viewmode.value;
+	do
+	{
+		next = (next + 1) % (VR_VIEW_DIORAMA + 1);
+	} while (next == VR_VIEW_THEATER
+		|| (next == VR_VIEW_FIRST_PERSON
+			&& gamestate == GS_LEVEL && leveltime < starttime));
+
+	CV_SetValue(&cv_vr_viewmode, next);
+	R_ResetViewInterpolation(0); // hard cut, no swoosh between modes
+}
+
+// Set only for the duration of P_UpdateCamerasNow, so a view slider can drive
+// the camera while the game is paused underneath the menu.
+static boolean camerarunwhilepaused = false;
