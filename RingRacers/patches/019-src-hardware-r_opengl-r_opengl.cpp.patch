+// The player's gr_filtermode is the REQUEST; min_filter/mag_filter/MipMap are
+// what GL actually gets. They differ in exactly one case: while an OpenXR
+// session is live, minification is forced onto the mipmap chain.
+//
+// Nearest minification with no mipmaps lets a single texel - whichever one
+// lands under the pixel centre - decide a cutout sprite's silhouette, because
+// the alpha test is a hard 0.5 threshold on one texture fetch. Two eyes are
+// never a whole number of texels apart, so each eye picks a different texel and
+// gets a different SHAPE for the same distant spike or spring. Your eyes can
+// converge on a shifted image; they cannot reconcile two different shapes, and
+// it worsens with distance as each pixel covers more texels.
+//
+// It must be the TRILINEAR variant, never GL_*_MIPMAP_NEAREST: a nearest tap
+// inside the chosen level still snaps the outline to that level's texel grid
+// and the two eyes still land on different texels of it. Only a filter smooth
+// in u, v AND lambda makes alpha a continuous function of screen position,
+// which is what puts the 0.5 crossing in the same place for both eyes.
+//
+// Magnification is left exactly as the player set it, so close-up pixel art is
+// untouched, and the cvar is never written - quitting VR leaves the config as
+// it was found.
+static void ApplyFilterMode(void)
+{
+	GLint want_min, want_mag;
+	GLboolean want_mip;
+
+	switch (filter_mode_requested)
+	{
+		case HWD_SET_TEXTUREFILTER_TRILINEAR:
+			want_min = GL_LINEAR_MIPMAP_LINEAR;
+			want_mag = GL_LINEAR;
+			want_mip = GL_TRUE;
+			break;
+		case HWD_SET_TEXTUREFILTER_BILINEAR:
+			want_min = want_mag = GL_LINEAR;
+			want_mip = GL_FALSE;
+			break;
+		case HWD_SET_TEXTUREFILTER_POINTSAMPLED:
+			want_min = want_mag = GL_NEAREST;
+			want_mip = GL_FALSE;
+			break;
+		case HWD_SET_TEXTUREFILTER_MIXED1:
+			want_min = GL_NEAREST;
+			want_mag = GL_LINEAR;
+			want_mip = GL_FALSE;
+			break;
+		case HWD_SET_TEXTUREFILTER_MIXED2:
+			want_min = GL_LINEAR;
+			want_mag = GL_NEAREST;
+			want_mip = GL_FALSE;
+			break;
+		case HWD_SET_TEXTUREFILTER_MIXED3:
+			want_min = GL_LINEAR_MIPMAP_LINEAR;
+			want_mag = GL_NEAREST;
+			want_mip = GL_TRUE;
+			break;
+		default:
+			want_mag = GL_LINEAR;
+			want_min = GL_NEAREST;
+			want_mip = GL_FALSE;
+			break;
+	}
+
+	// Keyed on the SESSION, not on the eye pass: the stereo flag goes up and
+	// down inside a single frame, and every change through here costs a full
+	// texture flush.
+	if (vr_is_active() && pgluBuild2DMipmaps)
+	{
+		want_min = GL_LINEAR_MIPMAP_LINEAR;
+		want_mip = GL_TRUE;
+	}
+
+	if (!pgluBuild2DMipmaps)
+	{
+		want_mip = GL_FALSE;
+		want_min = GL_LINEAR;
+	}
+
+	// Cheap enough to call every frame: nothing changed, nothing flushed.
+	if (want_min == min_filter && want_mag == mag_filter && want_mip == MipMap)
+		return;
+
+	// Say it out loud when the VR override takes or releases. "Did the fix
+	// actually engage" is otherwise unanswerable from the outside, and this
+	// project has already lost days to a fix that shipped and never ran.
+	if (vr_is_active() && want_mip && !MipMap)
+		CONS_Printf("VR: distant textures now mipmapped (minification only; magnification stays as set)\n");
+	else if (!vr_is_active() && MipMap && !want_mip)
+		CONS_Printf("VR: texture filtering back to your own setting\n");
+
+	min_filter = want_min;
+	mag_filter = want_mag;
+	MipMap = want_mip;
+
+	Flush(); // filters and mip chains are baked at upload; rebuild the cache
+}
