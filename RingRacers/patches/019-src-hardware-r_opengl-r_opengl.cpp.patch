+// Shader-based supersampling of the texture fetch: a 2x2 rotated grid
+// ("4 rooks") spread across the pixel's own footprint in texture space,
+// averaged. The level's textures are small pixel art carried at a single
+// mip level, so a minified texel grid aliases and crawls badly - four taps
+// inside the footprint average that away for a small fraction of what
+// rendering the whole frame at a higher resolution would cost. It is
+// self-limiting: under magnification the entire footprint sits inside one
+// texel, all four taps land on the same texel, and the art stays as crisp
+// as it was. The negative mip bias only bites when a mipmapped filter mode
+// is on, where it buys back the sharpness mipmapping gives away.
+//
+// The derivatives are taken before the branch on purpose - they are only
+// defined in uniform control flow, and this keeps them out of it entirely.
+#define GLSL_SUPERSAMPLE_FUNCTION \
+	"uniform float supersample;\n" \
+	"vec4 SampleTexture(sampler2D s, vec2 uv)\n" \
+	"{\n" \
+		"vec2 dx = dFdx(uv);\n" \
+		"vec2 dy = dFdy(uv);\n" \
+		"if (supersample < 0.5)\n" \
+			"return texture2D(s, uv);\n" \
+		"vec2 o = vec2(0.125, 0.375);\n" \
+		"vec4 acc = texture2D(s, uv + o.x * dx + o.y * dy, -1.0);\n" \
+		"acc += texture2D(s, uv - o.x * dx - o.y * dy, -1.0);\n" \
+		"acc += texture2D(s, uv + o.y * dx - o.x * dy, -1.0);\n" \
+		"acc += texture2D(s, uv - o.y * dx + o.x * dy, -1.0);\n" \
+		"acc *= 0.25;\n" \
+		/* Alpha does not get averaged. Cutout art is decided by a hard
+		   alpha test, so an averaged alpha turns the outline into a
+		   majority vote over the tap grid - and that grid's sub-texel
+		   phase lands differently in each eye, because two eyes are never
+		   a whole number of texels apart. Each eye then gets a slightly
+		   different SHAPE for the same spring or spike, which is the one
+		   disagreement binocular vision cannot resolve: it reads as the
+		   object being cross-eyed. The colour stays supersampled; the
+		   silhouette goes back to being exactly what the artist drew. */ \
+		"acc.a = texture2D(s, uv).a;\n" \
+		"return acc;\n" \
+	"}\n"
