+	// The triggers never nudge values. In any menu with section headers they
+	// page: jump to the next or previous section and land on its first
+	// entry - what a long options list actually wants from L/R. Menus with
+	// their own trigger handling (the character grid, addons, the pause
+	// menu's option shortcuts) consumed them upstream, and menus without
+	// headers leave the triggers quiet.
+	if (M_MenuButtonPressed(pid, MBT_R) || M_MenuButtonPressed(pid, MBT_L))
+	{
+		const SINT8 dir = M_MenuButtonPressed(pid, MBT_R) ? 1 : -1;
+		INT32 look = itemOn;
+		INT32 guard = currentMenu->numitems;
+
+		while (guard-- > 0)
+		{
+			look += dir;
+			if (look < 0)
+				look = currentMenu->numitems - 1;
+			else if (look >= currentMenu->numitems)
+				look = 0;
+
+			if ((currentMenu->menuitems[look].status & IT_HEADER) != IT_HEADER)
+				continue;
+
+			if (dir < 0)
+			{
+				// The header directly above lands you back where you already
+				// are - keep walking to the previous section instead.
+				INT32 first = look;
+				do
+					first++;
+				while (first < currentMenu->numitems
+					&& (currentMenu->menuitems[first].status & IT_TYPE) == IT_SPACE);
+				if (first == itemOn)
+					continue;
+			}
+
+			itemOn = (INT16)look;
+			M_NextOpt();
+			if (!(currentMenu->behaviourflags & MBF_SOUNDLESS))
