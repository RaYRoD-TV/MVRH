+// Centering positions the CLIENT area, so a window as tall as the usable area
+// ends up with its title bar hanging above the top of the screen - visible in
+// the code, invisible to the player, and impossible to drag. Push the frame
+// back inside the usable rect after centering. Fullscreen and borderless have
+// no frame to keep on screen and never come through here.
+static void NudgeWindowOnScreen(void)
+{
+	SDL_Rect usable;
+	SDL_DisplayID display;
+	int top = 0, left = 0, bottom = 0, right = 0;
+	int x = 0, y = 0;
+
+	if (window == NULL || borderlesswindow)
+		return;
+
+	display = (cv_display.string != NULL && cv_display.value != 0)
+		? static_cast<SDL_DisplayID>(cv_display.value)
+		: SDL_GetPrimaryDisplay();
+
+	if (!SDL_GetDisplayUsableBounds(display, &usable))
+		return;
+
+	SDL_GetWindowBordersSize(window, &top, &left, &bottom, &right);
+	SDL_GetWindowPosition(window, &x, &y);
+
+	// x/y are the client corner; the frame starts above and left of it.
+	if (y - top < usable.y)
+		y = usable.y + top;
+	if (x - left < usable.x)
+		x = usable.x + left;
+
+	SDL_SetWindowPosition(window, x, y);
+}
+
+// A window asked to be the size of the whole desktop pushes its own title bar
+// off the top of the screen and its bottom edge past the taskbar: it reads as
+// a broken fullscreen rather than as a window, and there's no frame left to
+// grab. Keep windowed mode inside the display's usable area (which already
+// excludes the taskbar) less the frame, so the border is always there.
+// Borderless is the deliberate way to ask for no frame, so it's left alone.
+static void ClampWindowedSize(INT32 *w, INT32 *h)
+{
+	SDL_Rect usable;
+	SDL_DisplayID display;
+	int top = 0, left = 0, bottom = 0, right = 0;
+	INT32 maxw, maxh;
+
+	// Borderless is the deliberate way to ask for no frame.
+	if (borderlesswindow)
+		return;
+
+	// Ask the same question the window path asks. cv_fullscreen on its own is
+	// the wrong test: it defaults to Yes and stays Yes under -win, which sets
+	// disable_fullscreen instead - so reading the cvar raw made this bail out
+	// on exactly the windowed launches it exists for. Parenthesised on its own
+	// line because the macro is a bare ternary: folded into a larger ||, the
+	// || would bind first and invert the meaning.
+	if ((USE_FULLSCREEN))
+		return;
+
+	if (SDL_WasInit(SDL_INIT_VIDEO) == 0)
+		return;
+
+	// The first mode is set before the cvars are registered, so cv_display
+	// has no string yet and ValidateDisplay's CV_SetValue would be fatal.
+	// Read the display instead of correcting it; whoever owns that cvar
+	// validates it later, and the primary display is the right answer until
+	// they do.
+	display = (cv_display.string != NULL && cv_display.value != 0)
+		? static_cast<SDL_DisplayID>(cv_display.value)
+		: SDL_GetPrimaryDisplay();
+
+	if (!SDL_GetDisplayUsableBounds(display, &usable))
+		return;
+
+	if (window != NULL)
+		SDL_GetWindowBordersSize(window, &top, &left, &bottom, &right);
+
+	// Before the window exists SDL has no frame to measure. A title bar is
+	// never thinner than this, and guessing low only costs a few pixels.
+	if (top <= 0)
+		top = 32;
+
+	maxw = usable.w - (left + right);
+	maxh = usable.h - (top + bottom);
+
+	if (maxw > 0 && *w > maxw)
+		*w = maxw;
+	if (maxh > 0 && *h > maxh)
+		*h = maxh;
+}
