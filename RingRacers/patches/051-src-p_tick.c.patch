 		if (player->mo != NULL && !player->exiting)
 		{
+			const fixed_t burn = K_HazardExposure(i);
+
+			// One headset, one pair of hands: only the first local player's
+			// pad can be the synthetic VR one, and a flat pad must keep
+			// feeling exactly what it always did.
+			const boolean vrfeel = (i == 0) && vr_is_active()
