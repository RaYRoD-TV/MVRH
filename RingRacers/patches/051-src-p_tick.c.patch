+			// you've been in it, so a clipped corner is a nudge and sitting
+			// in lava is not.
+			else if (burn > 0)
+			{
+				low = high = (UINT16)(((65536 / 3) * burn) / FRACUNIT);
+			}
+			// Wrecks and tricks. These are the states the first-person eye is
