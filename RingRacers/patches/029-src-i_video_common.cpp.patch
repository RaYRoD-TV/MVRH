+#ifdef ENABLE_VR
+// Run the chosen Screen Effect over the finished frame into an offscreen
+// copy at the game resolution, and hand back whatever the compositor should
+// sample - the untouched backbuffer when the effect is Nearest.
+//
+// Both VR surfaces are flat screens the player looks AT: the theater panel
+// and the HUD/menu quad. That is exactly what these filters are for, and
+// because the quad is anchored in the room the pattern rides the surface
+// instead of the eyes. The stereo world itself deliberately never comes
+// through here - a scanline mask locked to the eye would crawl over the
+// geometry with every head movement.
+//
+// keep_alpha carries the 2D pass's coverage through, which the HUD quad
+// composites from; the theater panel is a solid frame and drops it.
+static rhi::Handle<rhi::Texture> vr_screen_effect_copy(rhi::Rhi& rhi, bool keep_alpha)
+{
+	BlitRectPass* fx = nullptr;
+	switch (cv_scr_effect.value)
+	{
+	case 1: fx = g_hw_state.sharp_bilinear_blit_rect.get(); break;
+	case 2: fx = g_hw_state.crt_blit_rect.get(); break;
+	case 3: fx = g_hw_state.crtsharp_blit_rect.get(); break;
+	case 4: fx = g_hw_state.soft_blit_rect.get(); break;
+	default: break;
+	}
+
+	if (fx == nullptr)
+		return g_hw_state.backbuffer->color();
+
+	UpscaleBackbuffer* target =
+		(keep_alpha ? g_hw_state.vr_hud_backbuffer : g_hw_state.vr_panel_backbuffer).get();
+
+	target->begin_pass(rhi, keep_alpha);
+	rhi.update_texture_settings(
+		g_hw_state.backbuffer->color(),
+		TextureWrapMode::kClamp,
+		TextureWrapMode::kClamp,
+		TextureFilterMode::kLinear,
+		TextureFilterMode::kLinear
+	);
+	fx->set_blend(false);
+	// flip=true: the pass's projection flips Y for the window; the texcoord
+	// flip cancels it so the copy keeps the source orientation and the
+	// compositor samples it like the raw backbuffer.
+	fx->set_output(0, 0, vid.width, vid.height, false, true);
+	fx->set_texture(
+		g_hw_state.backbuffer->color(),
+		static_cast<uint32_t>(vid.width),
+		static_cast<uint32_t>(vid.height)
+	);
+	fx->draw(rhi);
+	rhi.pop_render_pass();
+
+	return target->color();
+}
+#endif
