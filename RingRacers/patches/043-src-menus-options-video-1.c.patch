+void M_RefreshVideoVROptions(void)
+{
+	// The VR page only exists while the headset session is live; the flat
+	// game hides it entirely (the same numitems trick that
+	// M_RefreshAdvancedVideoOptions plays with the legacy GL block).
+	OPTIONS_VideoDef.numitems = sizeof (OPTIONS_Video) / sizeof (menuitem_t);
+	if (!vr_is_active())
+		OPTIONS_VideoDef.numitems--;
+}
