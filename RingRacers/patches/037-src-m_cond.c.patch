+// The VR build opens the whole game up front on every load - no Goner Setup
+// (the forced Profile Card / PIN step), no tutorial gate, every unlockable -
+// whether or not a headset actually answered this launch; a sleeping or
+// absent HMD still counts as the VR build, and opening must be seamless.
+// Flat builds get the same via -unlockall on the command line. Mirrors the
+// fully-unlocked state the devmode password sets in m_pw.cpp, so it's a save
+// layout the game already supports. Deliberately does NOT touch usedCheats -
+// play and gamedata saving stay completely normal.
+static void M_UnlockAllFromCommandLine(void)
+{
+	INT32 i, count = 0;
+
+#ifndef ENABLE_VR
+	if (!M_CheckParm("-unlockall"))
+		return;
+#endif
+
+	for (i = 0; i < MAXUNLOCKABLES; i++)
+	{
+		if (!unlockables[i].conditionset)
+			continue;
+
+		gamedata->unlocked[i] = true;
+		gamedata->unlockpending[i] = false;
+		count++;
+	}
+
+	// Reveal hidden levels too, same as the devmode password.
+	for (i = 0; i < nummapheaders; i++)
+	{
+		if (!mapheaderinfo[i])
+			continue;
+
+		mapheaderinfo[i]->records.mapvisited |= MV_MAX;
+	}
+
+	// Skip the forced first-boot sequence, the tutorial gate,
+	// and the one-shot Sealed Star alert.
+	gamedata->gonerlevel = GDGONER_DONE;
+	gamedata->sealedswapalerted = true;
+	gamedata->enteredtutorialchallenge = true;
+	gamedata->finishedtutorialchallenge = true;
+	gamedata->tutorialdone = true;
+
+	CONS_Printf("Unlockall: goner setup skipped, %d unlockables unlocked\n", count);
+}
