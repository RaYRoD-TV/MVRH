+//
+// R_WarnMissingSprite
+// The installed assets carry no lumps for this sprite (code newer than the
+// data). Note it once and let the projectors skip the mobj - repeating the
+// alert every projected frame drowns the log and the on-screen console.
+//
+void R_WarnMissingSprite(INT32 sprnum, const char *caller)
+{
+	static UINT8 warned[NUMSPRITES];
+
+	if (sprnum < 0 || sprnum >= NUMSPRITES || warned[sprnum])
+		return;
+
+	warned[sprnum] = 1;
+	CONS_Alert(CONS_WARNING, M_GetText("%s: no frames loaded for sprite %s (assets predate it); leaving it undrawn.\n"),
+		caller, sprnames[sprnum]);
+}
