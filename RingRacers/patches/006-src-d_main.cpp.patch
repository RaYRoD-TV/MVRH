+// Feed the VR module the local kart's interpolated head pose (the anchor for
+// the first-person eye) and its spinout/tumble drama state, once per rendered
+// frame before the eye loop. Uses the same interpolation the renderer will
+// use, so the cockpit doesn't judder against the world at headset rates.
+static void D_FeedVRCockpit(void)
+{
+	player_t *player = &players[displayplayers[0]];
+	mobj_t *mo = player->mo;
+
+	if (mo == NULL)
+		return;
+
+	const fixed_t frac = R_UsingFrameInterpolation() ? rendertimefrac : FRACUNIT;
+	interpmobjstate_t interp;
+	R_InterpolateMobjState(mo, frac, &interp);
+
+	// mo->angle is the kart's facing; drawangle adds drift lean and the
+	// spinout spin, which feed the drama channel below instead.
+	const angle_t heading = R_InterpolateAngle(mo->old_angle, mo->angle);
+
+	// Look back. The chase camera already swings a full 180 for this on its
+	// own, but first person composes the eye ABSOLUTELY against the cockpit
+	// heading fed below - it places the eye at the kart's head and points it
+	// down this angle, whatever the camera behind it is doing. So the
+	// camera's swing was being subtracted straight back out and the headset
+	// showed nothing at all. The eye's heading is the only thing that has to
+	// turn; the seat slide keeps the unflipped angle, because a driver
+	// glancing over their shoulder does not slide across the seat.
+	angle_t eyeheading = heading;
+	if (K_GetKartButtons(player) & BT_LOOKBACK)
+		eyeheading += ANGLE_180;
+
+	// Head anchor: the kart origin plus the eye-height knob, scaled with the
+	// kart (tracks growth items and per-map object scale). Flipped gravity
+	// hangs the head below the ceiling-side origin instead.
+	const float eyeheight = vr_fp_eyeheight_units() * FIXED_TO_FLOAT(interp.scale);
+	float pos[3];
+	pos[0] = FIXED_TO_FLOAT(interp.x);
+	pos[1] = FIXED_TO_FLOAT(interp.y);
+	if (mo->eflags & MFE_VERTICALFLIP)
+		pos[2] = FIXED_TO_FLOAT(interp.z + mo->height) - eyeheight;
+	else
+		pos[2] = FIXED_TO_FLOAT(interp.z) + eyeheight;
+
+	// Seat slide: the forward knob moves the head anchor along the kart's own
+	// heading (scaled like the eye height), toward the nose or back off it.
+	const float seatfwd = vr_fp_forward_units() * FIXED_TO_FLOAT(interp.scale);
+	if (seatfwd != 0.0f)
+	{
+		pos[0] += seatfwd * cosf(ANG2RAD(heading));
+		pos[1] += seatfwd * sinf(ANG2RAD(heading));
+	}
+
+	vr_set_cockpit_pose(pos, ANG2RAD(eyeheading),
+		ANG2RAD(R_InterpolateAngle(mo->old_pitch, mo->pitch)),
+		ANG2RAD(R_InterpolateAngle(mo->old_roll, mo->roll)));
+
+	// In third person your own kart is the nearest thing that is never off
+	// screen, so it decides how much separation the eyes can take - and the
+	// Camera Forward knob can bring it right up to your face. Hand over the
+	// distance to its near side and let the module hold the disparity inside
+	// the fusion limit. Every other mode either hides the kart (first person)
+	// or holds everything at arm's length by construction.
+	if (vr_get_view_mode() == VR_VIEW_THIRD_PERSON)
+	{
+		// The camera steps once a tic while the kart glides every frame, so
+		// the gap between them has to be measured at the same moment or the
+		// separation it feeds would pulse at the tic rate - a breathing IPD,
+		// which is a worse thing to sit behind than the one being prevented.
+		const camera_t *cam = &camera[0];
+		const fixed_t camx = cam->old_x + FixedMul(cam->x - cam->old_x, frac);
+		const fixed_t camy = cam->old_y + FixedMul(cam->y - cam->old_y, frac);
+		const fixed_t camz = cam->old_z + FixedMul(cam->z - cam->old_z, frac);
+		const float dx = FIXED_TO_FLOAT(camx - interp.x);
+		const float dy = FIXED_TO_FLOAT(camy - interp.y);
+		const float dz = FIXED_TO_FLOAT(camz - interp.z);
+		const float span = FIXED_TO_FLOAT(mo->radius);
+		const float nearest = sqrtf(dx * dx + dy * dy + dz * dz) - span;
+		// Never hand over a zero: zero is the module's "no limit", and the
+		// camera sitting inside the kart is precisely when the limit matters.
+		vr_set_focus_distance(nearest < 1.0f ? 1.0f : nearest);
+	}
+	else
+	{
+		vr_set_focus_distance(0.0f);
+	}
+
+	// Drama: the states that spin the kart's sprite away from its facing (see
+	// P_MovePlayer). The raw angles are far past anything an eye can be
+	// carried through - a tumble turns drawangle at up to 4725 deg/s - so all
+	// that is handed over is WHICH KIND of thing is happening and which way it
+	// is going. The module shapes it, and holds anything the player did not
+	// ask for to a bounded lean.
+	const boolean tumbling = (player->tumbleBounces > 0);
+	const boolean spinning = (player->spinouttimer > 0 || player->icecube.frozen
+		|| player->carry == CR_SLIDING);
+	const boolean faulting = (player->pflags & PF_FAULT) != 0;
+	const boolean tricking = (player->trickpanel > TRICKSTATE_READY);
+	const boolean dramatic = (tumbling || spinning || faulting);
+
+	int dramakind = VR_DRAMA_NONE;
+	if (tumbling)
+		dramakind = VR_DRAMA_TUMBLE;
+	else if (spinning)
+		dramakind = VR_DRAMA_SPIN;
+	else if (faulting)
+		dramakind = VR_DRAMA_FAULT;
+	else if (tricking)
+	{
+		// The simulation spins the sprite's YAW for every trick direction, so
+		// which axis a trick reads as from the driver's seat has to come from
+		// the trick itself: sideways is a barrel roll, forward or back a flip.
+		// This is the one rotation the player pressed a button for, and until
+		// now it reached the headset as nothing at all.
+		dramakind = (player->trickpanel == TRICKSTATE_LEFT
+			|| player->trickpanel == TRICKSTATE_RIGHT)
+			? VR_DRAMA_TRICK_ROLL : VR_DRAMA_TRICK_FLIP;
+	}
+
+	// The shove of a landing dash, felt in the neck rather than only seen as a
+	// glow. Same channel the first-person boost cue reads, so the flash and
+	// the snap are the same event and land on the same tic.
+	vr_set_boost_kick(FIXED_TO_FLOAT(K_BoostKick(0)));
+
+	vr_set_action_cam(dramatic || tricking, player->exiting != 0);
+	vr_set_drama(dramakind,
+		(INT16)((player->drawangle - mo->angle) >> 16),
+		(INT16)(mo->rollangle >> 16));
+}
+#endif
